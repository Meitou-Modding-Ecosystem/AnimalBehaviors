<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Animal Behaviors (docs/animal-behaviors.md): the framework for animal mods. The animal registry, sexes and the Hitched job on every mod's
    hitching posts. Built against the game's assemblies, never copied: the game loads them.
  -->

  <PropertyGroup>
    <AssemblyName>AnimalBehaviors</AssemblyName>
    <RootNamespace>AnimalBehaviors</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Core/Meitou.Core.csproj" Private="false" />
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Data/Meitou.Data.csproj" Private="false" />
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Simulation/Meitou.Simulation.csproj" Private="false" />
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Game/Meitou.Game.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AnimalBehaviors.Tests" />
    <EmbeddedResource Include="Locale/*.json" LogicalName="AnimalBehaviors.Locale.%(Filename).json" WithCulture="false" />
    <None Include="meitou.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
